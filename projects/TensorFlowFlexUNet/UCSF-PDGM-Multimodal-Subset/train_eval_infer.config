; train_eval_infer.config
; 2026/09/16 (C) antillia.com

; UCSF-PDGM-Multimodal-Subset segmentation
[model]
model         = "TensorFlowFlexUNet"
generator     =  False

image_width    = 256
image_height   = 256
image_channels = 4
input_normalize = True
normalization  = False
num_classes    = 4
base_filters   = 16
base_kernels   = (11,11)

num_layers     = 8
dropout_rate   = 0.05
dilation       = (1,1)

; Model compilation parameters
optimizer       = "Adam"

learning_rate  = 0.00007
clipvalue      = 0.4

; Specify "categorical_crossentropy" function to loss
; for categoraized(one-hot-encoded) mask 
loss           = "categorical_crossentropy"
metrics        = ["dice_coef_multiclass"]

show_summary   = False

[dataset]
class_name    = "ImageCategorizedMaskDataset"

[train]
;epochs       = 50
epochs        = 100
batch_size    = 2

;steps_per_epoch  = 200
;validation_steps = 80

; EarlyStopping parameter
patience      = 10

metrics       = ["dice_coef_multiclass", "val_dice_coef_multiclass"]

model_dir     = "./models/"
eval_dir      = "./eval/"
images_dir    = "../../../dataset/UCSF-PDGM-Multimodal-Subset/train/images/"
masks_dir     = "../../../dataset/UCSF-PDGM-Multimodal-Subset/train/masks/"

create_backup  = False

; learning_rate_reducer callback parameter
learning_rate_reducer = True
reducer_factor     = 0.4
reducer_patience   = 4

; Model saving option
save_weights_only  = True

[valid]
images_dir = "../../../dataset/UCSF-PDGM-Multimodal-Subset/valid/images/"
masks_dir  = "../../../dataset/UCSF-PDGM-Multimodal-Subset/valid/masks/"

[test] 
images_dir = "../../../dataset/UCSF-PDGM-Multimodal-Subset/test/images/"
masks_dir  = "../../../dataset/UCSF-PDGM-Multimodal-Subset/test/masks/"

[infer] 
images_dir    = "./mini_test/images/"
output_dir    = "./mini_test_output/"
;2026/09/16
; Specify npy mini_test_images
; Specify a modality index.
; 0=FLAIR, 1=T1, 2=T1c, 3=T2
npy_slice_index =3
; Specify a slice output_dir
npy_slices_dir   = "./mini_test_t2_slices/"

[image]
color_order = "RGB"
file_format = "NPY"

[mask]
mask_datatyoe    = "categorized"
mask_file_format = ".png"
;UCSF-PDGM-Multimodal-Subset RGB color map dict for 1+3 classes.
;        Background;black, NET/NCR:red, ED: green, ET:blue
rgb_map = {(0,0,0):0,(255,0,0):1, (0,255,0):2,(0,0,255):3,}


[infer3d] 
;Specify an images_dir which contains NIfTI or NPY files
images_dir    = "./mini_test_3d/images/"
output_dir    = "./mini_test_3d_output/"
slice_shape_order = "hwd"
slice_normalize = True
slice_resize   = (256,256)
;Specify a cv2.rotation mode as a string.
slice_rotation = "cv2.ROTATE_90_COUNTERCLOCKWISE" 

mask_overlay  = True
;Specify ".mp4" or ".gif".
;video_fileformat  = ".mp4"
video_fileformat  = ".gif"